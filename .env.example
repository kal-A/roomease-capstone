# Application URL and NextAuth session signing
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Microsoft Entra ID / Azure AD OAuth application
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Supabase browser-safe project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
# Legacy projects may use this instead of the publishable key above.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated production administrator identities.
ROOM_EASE_ADMIN_EMAILS=
# Comma-separated production executive identities until roles move to the database.
ROOM_EASE_EXECUTIVE_EMAILS=

# Demo behavior is server-only, opt-in, and rejected in production.
ROOM_EASE_DEMO_MODE=false
ROOM_EASE_DEMO_MEMBER_EMAIL=
ROOM_EASE_DEMO_EXECUTIVE_EMAIL=

# Additional acknowledgement required by demo data mutation scripts.
ROOM_EASE_ALLOW_DEMO_SEED=false
